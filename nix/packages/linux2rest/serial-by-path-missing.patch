# Treats a missing /dev/serial/by-path as an empty directory instead of a warn.
#
# 60-serial.rules only creates that directory while a ttyUSB/ttyACM device is
# present, and udev removes it again when the last one is unplugged. Boards
# without a USB serial adapter therefore hit ENOENT on every lookup, and
# fetch_by_path runs once per enumerated port per poll: the recorder's
# serial-ports interval plus every frontend /serial?udev=true request. The
# {error:#?} rendering is five lines, so each miss costs ~5 journal entries.
# The port still reports by_path: null either way, so only the log changes.
#
# Upstreamable: any host without a USB serial adapter is affected.
--- a/src/features/serial.rs
+++ b/src/features/serial.rs
@@ -42,7 +42,11 @@ impl PortInfo {
         let dir = std::fs::read_dir(by_path_dir);
         if dir.is_err() {
             let error = dir.err().unwrap();
-            warn!("Failed to look over {by_path_dir}: {error:#?}");
+            // udev only creates the directory while a USB serial port is
+            // plugged in, so its absence is the normal state, not a failure.
+            if error.kind() != std::io::ErrorKind::NotFound {
+                warn!("Failed to look over {by_path_dir}: {error:#?}");
+            }
             return (None, None);
         }
 
