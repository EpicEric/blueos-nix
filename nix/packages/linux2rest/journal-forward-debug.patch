# Logs forwarded journal and kernel messages at debug instead of info.
#
# Under the container, linux2rest's stdout goes to Docker's log driver, so the
# "Sending journal message to zenoh" line never reaches journald. Its journalctl
# follower therefore only ever reads messages from other services. Running it as
# a systemd unit puts stdout back in the journal, and every forwarded entry
# produces a new entry that the same follower picks up: at info level the echo
# is 94% of the journal, ~1.5 MB/s, and never catches up.
#
# debug keeps the line available with RUST_LOG=debug while the default info
# filter drops it, so nothing reaches stdout and the follower never sees its own
# output.
#
# Upstreamable: the same fix is correct in the container for anyone who collects
# stdout into journald there.
--- a/src/recorder/mod.rs
+++ b/src/recorder/mod.rs
@@ -34,7 +34,7 @@
             };
 
             while let Ok(Some(message)) = kernel_client.try_next() {
-                info!("Sending kernel message to zenoh: {message}");
+                debug!("Sending kernel message to zenoh: {message}");
                 zenoh_session
                     .put(zenoh_topic_name.replace("{}", "kernel"), message)
                     .encoding(zenoh::bytes::Encoding::APPLICATION_JSON)
@@ -43,7 +43,7 @@
             }
 
             while let Ok(Some(message)) = journal_client.try_next() {
-                info!("Sending journal message to zenoh: {message}");
+                debug!("Sending journal message to zenoh: {message}");
                 zenoh_session
                     .put(zenoh_topic_name.replace("{}", "journal"), message)
                     .encoding(zenoh::bytes::Encoding::APPLICATION_JSON)
