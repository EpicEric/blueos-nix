# Podman and Docker disagree about what `images.pull` means, so the reference
# is passed in the one form both interpret the same way. Upstreamable: nothing
# here is NixOS-specific, it is a Podman compatibility fix.
diff --git a/core/services/kraken/extension/extension.py b/core/services/kraken/extension/extension.py
index cd26b0f..60d81ec 100644
--- a/core/services/kraken/extension/extension.py
+++ b/core/services/kraken/extension/extension.py
@@ -255,16 +255,25 @@ class Extension:
 
     async def _pull_docker_image(self, docker_auth: Optional[str]) -> AsyncGenerator[bytes, None]:
         """Pull Docker image and yield progress updates."""
-        tag = f"{self.source.docker}:{self.tag}" + (f"@{self.digest}" if self.digest else "")
+        # Podman appends `tag` to `fromImage` verbatim, so a reference that
+        # already holds the tag becomes "repo:tag:tag". Docker applies `tag`
+        # over `fromImage` instead. Passing the bare repository and letting the
+        # tag argument carry the digest is the only form that means the same
+        # thing to both.
+        reference = f"{self.source.docker}@{self.digest}" if self.digest else f"{self.source.docker}:{self.tag}"
         async with DockerCtx() as client:
             async for line in client.images.pull(
-                tag, repo=self.source.docker, tag=self.tag, auth=docker_auth, stream=True
+                self.source.docker,
+                repo=self.source.docker,
+                tag=self.digest or self.tag,
+                auth=docker_auth,
+                stream=True,
             ):
                 # TODO - Plug Error detection from docker image here
                 yield json.dumps(line).encode("utf-8")
-            # Make sure to add correct tag if a digest was used since docker messes up the tag
+            # A digest pull leaves the image untagged, so name it for the settings entry.
             if self.digest:
-                await client.images.tag(tag, f"{self.source.docker}:{self.tag}")
+                await client.images.tag(reference, self.source.docker, tag=self.tag)
 
     async def _clear_remaining_tags(self) -> None:
         """Uninstall all other tags for this extension."""
@@ -362,8 +371,12 @@ class Extension:
                         self.lock(self.unique_entry)
 
                         tag = img_name + (f"@{self.digest}" if self.digest else "")
-                        await client.images.pull(tag, repo=self.source.docker, tag=self.tag)
-                        # Make sure to add correct tag if a digest was used since docker messes up the tag
+                        await client.images.pull(
+                            self.source.docker,
+                            repo=self.source.docker,
+                            tag=self.digest or self.tag,
+                        )
+                        # A digest pull leaves the image untagged, so name it for the settings entry.
                         if self.digest:
                             await client.images.tag(tag, img_name)
                     except Exception as error:
